# =============================================================================
# AED 急救协作模板 — 根忽略规则与公开交付边界
#
# 公共交付集由源码、公开文档和合成演示数据组成。
# 发布/交付前的脱敏与边界检查由维护者在本地工作区执行（工具不随仓库发布）。
# =============================================================================

# --- 依赖与构建缓存 ---------------------------------------------------------
node_modules/
unpackage/
dist/
bin/
obj/
publish/
*.tsbuildinfo
__pycache__/
*.py[cod]

# --- 运行时数据（本地启动后端产生的数据库、上传、备份，不属于交付集）------
# demo/ 是随源码交付的合成演示数据，必须保留。
data/
!demo/data/
uploads/
*.db
*.db-wal
*.db-shm
*.sqlite

# --- 本地秘密与个人环境文件（只保留可公开的样例文件）---------------------
appsettings.Development.local.json
.env
.env.*
!.env.example
!**/.env.example
*.local

# --- Admin 构建产物 ---------------------------------------------------------
# 由 admin/ 执行 `pnpm build` 生成并输出到后端静态目录（base 为 /admin/）；
# 可随时重建，不入库。脱敏扫描器仍会把该目录当作“实际构建产物”扫描，
# 因此交付前需要先构建：cd admin; pnpm build。
backend/src/AedBackend.Api/wwwroot/admin/

# --- 日志与编辑器临时文件 ---------------------------------------------------
logs/
*.log
.DS_Store
.idea/
.vscode/

