# AED 急救协作小程序 — 环境变量模板
#
# 复制本文件为 .env.development / .env.production 后按需填写；
# 没有 .env 文件时按 VITE_APP_MODE=mock 构建（仅前端演示，不需要后端）。
# ⚠️ 禁止提交包含真实 AppSecret、管理密钥或 token 的 .env 文件。
#
# ── 三档位：VITE_APP_MODE ────────────────────────────────────────────────
# mock       纯前端合成数据演示；不访问后端、不拨号、不发真实通知。
#            构建/演示开箱可用（config/site.json + demo/ 生成数据）。
# local-demo 本地真实后端：先按根 README 完成 SQLite 初始化与后端启动，
#            再用 demo/roles.json 的固定 code（demo-requester /
#            demo-rescuer / demo-unqualified）经真实登录接口换取 bearer。
#            必须配置 VITE_API_BASE_URL；只有 Development + 回环监听可用。
# wechat     真实微信模式：wx.login、真实业务 API、真实定位。
#            自备合法域名、AppID、https/ws 与地图 Key；不接受演示 code。
# 非法档位、或非 mock 档缺少 VITE_API_BASE_URL，构建/启动会明确报错，
# 不会静默回落到 mock。
#
# ── 站点内容 ────────────────────────────────────────────────────────────
# 机构名、标题、校区、地图中心、检索城市、服务半径、急救热线都在仓库根
# config/site.json（唯一手工维护真源），不通过环境变量覆盖。
#
# ── API 地址 ────────────────────────────────────────────────────────────
# 本地后端约定端口为 127.0.0.1:5150（后端 launchSettings / Admin dev 代理一致）。
# local-demo 需先按根 README 完成 SQLite 初始化并启动后端，再用
# VITE_APP_MODE=local-demo + VITE_API_BASE_URL=http://127.0.0.1:5150 构建。
# 不含 /api 路径段；api/*.ts 使用完整路径如 /api/aed/nearby。
# mock 档不会发起请求，此值仅作占位/诊断，不访问网络。

VITE_APP_MODE=mock

VITE_API_BASE_URL=http://127.0.0.1:5150

VITE_APP_ENV=development

# production 下默认 true；本地开发可显式关闭，避免复用旧登录态
VITE_RESTORE_AUTH_SESSION=false

# 地址解析用的腾讯地图 Key（公开前端 Key，可为空；为空时地址解析降级）
VITE_TENCENT_MAP_KEY=

# 单张图片上传上限（字节）
VITE_UPLOAD_MAX_SIZE=5242880

# 求助告警订阅消息模板 ID；为空时订阅入口显示“未配置”，不会真实发送
VITE_WECHAT_ALERT_TEMPLATE_ID=
