{
  "name": "aed-emergency-miniprogram",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "AED 急救协作小程序（迁移模板，演示数据均为合成数据）",
  "scripts": {
    "dev:h5": "cross-env UNI_INPUT_DIR=. uni",
    "dev:mp-weixin": "pnpm sync:demo && cross-env UNI_INPUT_DIR=. uni -p mp-weixin",
    "build:h5": "cross-env UNI_INPUT_DIR=. uni build",
    "build:mp-weixin": "pnpm sync:demo && cross-env UNI_INPUT_DIR=. uni build -p mp-weixin && pnpm sync:static && node scripts/write-build-metadata.mjs production",
    "build:mp-weixin:preview": "pnpm sync:demo && cross-env UNI_INPUT_DIR=. uni build -p mp-weixin --mode preview && pnpm sync:static && node scripts/write-build-metadata.mjs preview",
    "sync:demo": "node scripts/sync-demo-data.mjs",
    "assets:generate": "node scripts/generate-demo-assets.mjs",
    "sync:static": "node scripts/sync-static.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.js --max-warnings 0",
    "lint:fix": "eslint . --ext .vue,.ts,.js --fix",
    "format": "prettier --write \"**/*.{vue,ts,js,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{vue,ts,js,scss,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "contract:validate": "npx --yes @redocly/cli lint contracts/openapi.yaml --skip-rule no-unused-components",
    "commitlint:ci": "commitlint --from $COMMITLINT_FROM --to $COMMITLINT_TO"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080420251103001",
    "@dcloudio/uni-app-plus": "3.0.0-4080420251103001",
    "@dcloudio/uni-components": "3.0.0-4080420251103001",
    "@dcloudio/uni-h5": "3.0.0-4080420251103001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080420251103001",
    "pinia": "^2.2.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-4080420251103001",
    "@dcloudio/uni-cli-shared": "3.0.0-4080420251103001",
    "@dcloudio/uni-stacktracey": "3.0.0-4080420251103001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080420251103001",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.8.3",
    "sass": "^1.77.0",
    "typescript": "^5.9.3",
    "vite": "5.2.8",
    "vitest": "^1.6.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}

